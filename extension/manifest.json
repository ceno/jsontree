{
  "manifest_version": 3,
  "name": "jsontree",
  "version": "1.0.0",
  "description": "Renders JSON documents with the jsontree viewer instead of raw text.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "jsontree",
    "default_popup": "grant.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting"],
  "optional_host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "run_at": "document_start",
      "js": ["vendor/markup.js", "bootstrap.js", "vendor/app.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/style.css", "vendor/favicon.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
